@article{lu2026patchcon,
  abbr        = {arXiv},
  bibtex_show = {true},
  title       = {PatchCon: Patch-aware Weighted Supervised Contrastive Learning for Vulnerability Detection},
  author      = {Lu, Chaomeng and Rostami Mazrae, Pooya and Lagaisse, Bert},
  journal     = {arXiv preprint arXiv:2611.06583},
  year        = {2026},
  month       = {nov},
  note        = {Under review},
  arxiv       = {2611.06583},
  code        = {https://github.com/Chaomeng-Lu/PatchCon},
  abstract    = {PatchCon is a CodeBERT-based vulnerability detection model that jointly optimizes vulnerability classification and supervised contrastive learning, treating vulnerable–patched function pairs as weighted hard negatives so the model learns the subtle, fix-related differences between them. On PairVul-Linux, PatchCon improves pairwise accuracy over the strongest reproduced baseline from 0.21 to 0.33 (+58%), matches a GPT-4o-based LLM method at substantially lower cost, and generalizes best to unseen CVEs and newly disclosed Linux kernel vulnerabilities.},
  selected    = {true}
}

